# 多媒體程式設計學習目標

```python
class MultimediaGoals:
    def __init__(self):
        self.goals = []
    
    def add(self, category, title, level):
        self.goals.append({'category': category, 'title': title, 'level': level})
    
    def show(self):
        categories = {}
        for g in self.goals:
            if g['category'] not in categories:
                categories[g['category']] = []
            categories[g['category']].append(g)
        
        print("=" * 50)
        print("多媒體程式設計學習目標")
        print("=" * 50)
        for cat in sorted(categories.keys()):
            print(f"\n【{cat}】")
            for i, g in enumerate(categories[cat], 1):
                print(f"  {i}. {g['title']} ({g['level']})")

# 初始化目標
goals = MultimediaGoals()

# 基礎概念
goals.add('基礎概念', '數位媒體基礎', '初級')
